{
  "name": "aeve-pos",
  "version": "1.0.0",
  "description": "AEVE - Logiciel Point de vente Intelligent",
  "author": "AEVE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.aeve.pos",
    "productName": "AEVE - Logiciel Point de vente Intelligent",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": null,
      "certificateFile": null,
      "sign": null
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.git"
        ]
      },
      {
        "from": "frontend/out",
        "to": "frontend/out"
      },
      {
        "from": "resources/node/node.exe",
        "to": "node/node.exe"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  }
}
